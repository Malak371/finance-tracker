# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (postgres://, postgresql:// and postgresql+psycopg:// are all accepted)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_tracker

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
